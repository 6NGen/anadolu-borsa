<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran fiyat widget'ı: 3 ürün + tarih. Veriyi FiyatWidget.kt doldurur. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌾 ANADOLU BORSA"
            android:textColor="#6FD39A"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/w_tarih"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6B8270"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_ad1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#EAF3EC"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/w_f1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8C040"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_ad2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#EAF3EC"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/w_f2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8C040"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_ad3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#EAF3EC"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/w_f3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8C040"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
